{
  "name": "exam-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @exam-runtime/web",
    "build:backend": "tsc -b packages/cli packages/mcp",
    "typecheck": "tsc -b",
    "test": "npm run build:backend && vitest run",
    "test:watch": "npm run build:backend && vitest",
    "cli": "node packages/cli/dist/main.js",
    "dev:api": "npm run build:backend && npm run cli -- serve",
    "dev:web": "npm run dev -w @exam-runtime/web"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
